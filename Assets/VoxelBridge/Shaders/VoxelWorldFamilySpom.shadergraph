{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "38c6cce252ea4f0894f6cdfd6f3b86d6",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "VoxelPaletteSample (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 100,
            "y": 350,
            "width": 280,
            "height": 200
        }
    },
    "m_Slots": [
        {
            "m_Id": "95c719249b444dd69ecc8f804c5c1134"
        },
        {
            "m_Id": "a502873b331e47ec94aa0cfe2f9bbc66"
        },
        {
            "m_Id": "e015a366d5564dec8aea2fb0fc5e6c0f"
        },
        {
            "m_Id": "04cab5e213bc4bf68f3b9773b6e5ed8c"
        },
        {
            "m_Id": "92825aa6dc4746c28fc1b74c7985051d"
        },
        {
            "m_Id": "373faaaf5c504519a6bbd4687a6af770"
        },
        {
            "m_Id": "bdd772e2f32b4f7ba4adb7cd989102df"
        },
        {
            "m_Id": "733bf1b806b14b2486e8da67586fd947"
        },
        {
            "m_Id": "ed0b139f6a924ff78d2760262ca132e1"
        },
        {
            "m_Id": "b155379fadb04f69865013b9ad6f9ed5"
        },
        {
            "m_Id": "a4c534870e85efbe061639fb432bbb19"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "VoxelPaletteSample",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float surfaceWidth = max(1.0, SurfacePalette.texelSize.z);\nfloat maxSurfaceId = surfaceWidth - 1.0;\nfloat surfaceId = clamp(floor(SurfaceData.x + 0.5), 0.0, maxSurfaceId);\n\nfloat2 surfaceUV = float2(\n    (surfaceId + 0.5) * SurfacePalette.texelSize.x,\n    0.5 * SurfacePalette.texelSize.y);\n\nfloat4 colorSample = SAMPLE_TEXTURE2D_LOD(\n    ColorPalette.tex,\n    ColorPalette.samplerstate,\n    float2((clamp(floor(ColorData.x + 0.5), 0.0, 255.0) + 0.5) / 256.0, 0.5),\n    0.0);\n\nfloat4 surfaceSample = SAMPLE_TEXTURE2D_LOD(\n    SurfacePalette.tex,\n    SurfacePalette.samplerstate,\n    surfaceUV,\n    0.0);\n\nBaseColor = colorSample.rgb;\nMetallic = saturate(surfaceSample.r);\nSmoothness = saturate(surfaceSample.g);\nEmission = BaseColor * saturate(surfaceSample.b) * max(0.0, EmissionIntensity);\nOcclusion = saturate(surfaceSample.a);\n\n// Optional second row; one-row palettes preserve zero variation.\nSurfaceHeightVariation = 0.0;\nif (SurfacePalette.texelSize.w > 1.5)\n    SurfaceHeightVariation = saturate(SAMPLE_TEXTURE2D_LOD(SurfacePalette.tex, SurfacePalette.samplerstate,\n        float2(surfaceUV.x, 1.5 * SurfacePalette.texelSize.y), 0.0).r) * 0.25;"
}

