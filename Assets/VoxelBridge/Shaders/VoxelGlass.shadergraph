    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "VoxelGlassSample",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Native HDRP alpha testing handles raster discard and DXR hit rejection.\n// Reject non-glass faces even at opacity 1; retain glass specular at opacity 0.\nClipThreshold = SurfaceData.y >= 0.5 ? 0.0 : 2.0;\nfloat surfaceWidth = max(1.0, SurfacePalette.texelSize.z);\nfloat maxSurfaceId = surfaceWidth - 1.0;\nfloat surfaceId = clamp(floor(SurfaceData.x + 0.5), 0.0, maxSurfaceId);\n\nfloat2 surfaceUV = float2(\n    (surfaceId + 0.5) * SurfacePalette.texelSize.x,\n    0.5 * SurfacePalette.texelSize.y);\n\nfloat4 colorSample = SAMPLE_TEXTURE2D_LOD(\n    ColorPalette.tex,\n    ColorPalette.samplerstate,\n    float2((clamp(floor(ColorData.x + 0.5), 0.0, 255.0) + 0.5) / 256.0, 0.5),\n    0.0);\n\nfloat4 surfaceSample = SAMPLE_TEXTURE2D_LOD(\n    SurfacePalette.tex,\n    SurfacePalette.samplerstate,\n    surfaceUV,\n    0.0);\n\nBaseColor = colorSample.rgb;\nMetallic = saturate(surfaceSample.r);\nSmoothness = saturate(surfaceSample.g);\nEmission = BaseColor * saturate(surfaceSample.b) * max(0.0, EmissionIntensity);\nOpacity = saturate(surfaceSample.a);"
}

