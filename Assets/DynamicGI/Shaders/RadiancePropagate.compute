#pragma kernel PropagateRadiance
#pragma target 5.0

#include "GeometryField.hlsl"

RWTexture3D<float4> _DynamicGI_RadiancePositiveX;
RWTexture3D<float4> _DynamicGI_RadianceNegativeX;
RWTexture3D<float4> _DynamicGI_RadiancePositiveY;
RWTexture3D<float4> _DynamicGI_RadianceNegativeY;
RWTexture3D<float4> _DynamicGI_RadiancePositiveZ;
RWTexture3D<float4> _DynamicGI_RadianceNegativeZ;

Texture3D<float4> _PropagationDirectPositiveX;
Texture3D<float4> _PropagationDirectNegativeX;
Texture3D<float4> _PropagationDirectPositiveY;
Texture3D<float4> _PropagationDirectNegativeY;
Texture3D<float4> _PropagationDirectPositiveZ;
Texture3D<float4> _PropagationDirectNegativeZ;

Texture3D<float4> _PropagationInputPositiveX;
Texture3D<float4> _PropagationInputNegativeX;
Texture3D<float4> _PropagationInputPositiveY;
Texture3D<float4> _PropagationInputNegativeY;
Texture3D<float4> _PropagationInputPositiveZ;
Texture3D<float4> _PropagationInputNegativeZ;

float3 _DynamicGI_RadianceOrigin;
float3 _DynamicGI_RadianceSize;
int3 _DynamicGI_RadianceResolution;
int3 _RadianceRingOffset;
int _RadianceToroidal;
int3 _PropagationUpdateOffset;
int3 _PropagationUpdateSize;
float _PropagationStrength;
float _PropagationDirectionalRetention;
float _PropagationDistanceAttenuation;
float _PropagationMaximumRadiance;
float _RadianceRayOriginBias;
int _RadianceMaxDdaSteps;

struct RadianceProbeData
{
    float4 PositiveX;
    float4 NegativeX;
    float4 PositiveY;
    float4 NegativeY;
    float4 PositiveZ;
    float4 NegativeZ;
};

float3 RadianceCellSize()
{
    return _DynamicGI_RadianceSize / (float3)_DynamicGI_RadianceResolution;
}

float3 RadianceProbePosition(int3 coordinate)
{
    return _DynamicGI_RadianceOrigin + ((float3)coordinate + 0.5) * RadianceCellSize();
}

int3 RadiancePhysicalCoordinate(int3 logicalCoordinate)
{
    return _RadianceToroidal != 0
        ? (logicalCoordinate + _RadianceRingOffset) & (_DynamicGI_RadianceResolution - 1)
        : logicalCoordinate;
}

RadianceProbeData ReadDirect(int3 logicalCoordinate)
{
    int3 coordinate = RadiancePhysicalCoordinate(logicalCoordinate);
    RadianceProbeData value;
    value.PositiveX = _PropagationDirectPositiveX.Load(int4(coordinate, 0));
    value.NegativeX = _PropagationDirectNegativeX.Load(int4(coordinate, 0));
    value.PositiveY = _PropagationDirectPositiveY.Load(int4(coordinate, 0));
    value.NegativeY = _PropagationDirectNegativeY.Load(int4(coordinate, 0));
    value.PositiveZ = _PropagationDirectPositiveZ.Load(int4(coordinate, 0));
    value.NegativeZ = _PropagationDirectNegativeZ.Load(int4(coordinate, 0));
    return value;
}

RadianceProbeData ReadInput(int3 logicalCoordinate)
{
    int3 coordinate = RadiancePhysicalCoordinate(logicalCoordinate);
    RadianceProbeData value;
    value.PositiveX = _PropagationInputPositiveX.Load(int4(coordinate, 0));
    value.NegativeX = _PropagationInputNegativeX.Load(int4(coordinate, 0));
    value.PositiveY = _PropagationInputPositiveY.Load(int4(coordinate, 0));
    value.NegativeY = _PropagationInputNegativeY.Load(int4(coordinate, 0));
    value.PositiveZ = _PropagationInputPositiveZ.Load(int4(coordinate, 0));
    value.NegativeZ = _PropagationInputNegativeZ.Load(int4(coordinate, 0));
    return value;
}

float3 AverageRadiance(RadianceProbeData value)
{
    return (value.PositiveX.rgb + value.NegativeX.rgb + value.PositiveY.rgb +
            value.NegativeY.rgb + value.PositiveZ.rgb + value.NegativeZ.rgb) / 6.0;
}

void AccumulateVisibleNeighbor(
    int3 neighborCoordinate,
    float3 positionWS,
    inout RadianceProbeData directionalSum,
    inout float3 isotropicSum,
    inout float visibleWeight)
{
    if (any(neighborCoordinate < 0) || any(neighborCoordinate >= _DynamicGI_RadianceResolution))
        return;

    float3 neighborPosition = RadianceProbePosition(neighborCoordinate);
    float3 delta = neighborPosition - positionWS;
    float distanceToNeighbor = length(delta);
    if (distanceToNeighbor <= 1e-5)
        return;
    float3 direction = delta / distanceToNeighbor;
    float bias = min(_RadianceRayOriginBias, distanceToNeighbor * 0.2);
    float traceDistance = max(0.0, distanceToNeighbor - bias * 2.0);
    if (traceDistance > 0.0 && DynamicGITraceGeometryDDA(
            positionWS + direction * bias,
            direction,
            traceDistance,
            _RadianceMaxDdaSteps))
    {
        return;
    }

    RadianceProbeData neighbor = ReadInput(neighborCoordinate);
    float validity = saturate((neighbor.PositiveX.a + neighbor.NegativeX.a + neighbor.PositiveY.a +
                               neighbor.NegativeY.a + neighbor.PositiveZ.a + neighbor.NegativeZ.a) / 6.0);
    if (validity <= 0.0)
        return;

    directionalSum.PositiveX.rgb += neighbor.PositiveX.rgb * validity;
    directionalSum.NegativeX.rgb += neighbor.NegativeX.rgb * validity;
    directionalSum.PositiveY.rgb += neighbor.PositiveY.rgb * validity;
    directionalSum.NegativeY.rgb += neighbor.NegativeY.rgb * validity;
    directionalSum.PositiveZ.rgb += neighbor.PositiveZ.rgb * validity;
    directionalSum.NegativeZ.rgb += neighbor.NegativeZ.rgb * validity;
    isotropicSum += AverageRadiance(neighbor) * validity;
    visibleWeight += validity;
}

float4 ResolveLobe(float4 direct, float3 directional, float3 isotropic, float visibleWeight)
{
    if (visibleWeight <= 0.0)
        return direct;
    float3 transported = lerp(isotropic, directional, _PropagationDirectionalRetention) / visibleWeight;
    float3 bounced = transported * (_PropagationStrength * _PropagationDistanceAttenuation);
    return float4(min(direct.rgb + bounced, _PropagationMaximumRadiance.xxx), direct.a);
}

[numthreads(4, 4, 4)]
void PropagateRadiance(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (any(dispatchThreadId >= (uint3)_PropagationUpdateSize))
        return;

    int3 coordinate = _PropagationUpdateOffset + (int3)dispatchThreadId;
    if (any(coordinate < 0) || any(coordinate >= _DynamicGI_RadianceResolution))
        return;

    float3 positionWS = RadianceProbePosition(coordinate);
    int3 physicalCoordinate = RadiancePhysicalCoordinate(coordinate);
    if (SampleGeometryOccupancy(positionWS) != 0u)
    {
        float4 zero = 0.0;
        _DynamicGI_RadiancePositiveX[physicalCoordinate] = zero;
        _DynamicGI_RadianceNegativeX[physicalCoordinate] = zero;
        _DynamicGI_RadiancePositiveY[physicalCoordinate] = zero;
        _DynamicGI_RadianceNegativeY[physicalCoordinate] = zero;
        _DynamicGI_RadiancePositiveZ[physicalCoordinate] = zero;
        _DynamicGI_RadianceNegativeZ[physicalCoordinate] = zero;
        return;
    }

    RadianceProbeData direct = ReadDirect(coordinate);
    RadianceProbeData directionalSum = (RadianceProbeData)0;
    float3 isotropicSum = 0.0;
    float visibleWeight = 0.0;
    AccumulateVisibleNeighbor(coordinate + int3(1, 0, 0), positionWS, directionalSum, isotropicSum, visibleWeight);
    AccumulateVisibleNeighbor(coordinate + int3(-1, 0, 0), positionWS, directionalSum, isotropicSum, visibleWeight);
    AccumulateVisibleNeighbor(coordinate + int3(0, 1, 0), positionWS, directionalSum, isotropicSum, visibleWeight);
    AccumulateVisibleNeighbor(coordinate + int3(0, -1, 0), positionWS, directionalSum, isotropicSum, visibleWeight);
    AccumulateVisibleNeighbor(coordinate + int3(0, 0, 1), positionWS, directionalSum, isotropicSum, visibleWeight);
    AccumulateVisibleNeighbor(coordinate + int3(0, 0, -1), positionWS, directionalSum, isotropicSum, visibleWeight);

    _DynamicGI_RadiancePositiveX[physicalCoordinate] = ResolveLobe(direct.PositiveX, directionalSum.PositiveX.rgb, isotropicSum, visibleWeight);
    _DynamicGI_RadianceNegativeX[physicalCoordinate] = ResolveLobe(direct.NegativeX, directionalSum.NegativeX.rgb, isotropicSum, visibleWeight);
    _DynamicGI_RadiancePositiveY[physicalCoordinate] = ResolveLobe(direct.PositiveY, directionalSum.PositiveY.rgb, isotropicSum, visibleWeight);
    _DynamicGI_RadianceNegativeY[physicalCoordinate] = ResolveLobe(direct.NegativeY, directionalSum.NegativeY.rgb, isotropicSum, visibleWeight);
    _DynamicGI_RadiancePositiveZ[physicalCoordinate] = ResolveLobe(direct.PositiveZ, directionalSum.PositiveZ.rgb, isotropicSum, visibleWeight);
    _DynamicGI_RadianceNegativeZ[physicalCoordinate] = ResolveLobe(direct.NegativeZ, directionalSum.NegativeZ.rgb, isotropicSum, visibleWeight);
}
