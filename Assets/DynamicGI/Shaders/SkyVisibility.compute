#pragma kernel ClearSkyVisibility
#pragma kernel ComputeSkyVisibility
#pragma kernel QuerySkyVisibility
#pragma kernel BuildSkyVisibilityDebug
#pragma target 5.0

#include "GeometryField.hlsl"

RWTexture3D<float> _DynamicGI_SkyVisibilityTexture;
Texture3D<float> _SkyVisibilityRead;
SamplerState sampler_SkyVisibilityRead;

StructuredBuffer<float3> _SkyQueryPositions;
RWStructuredBuffer<float> _SkyQueryResults;
AppendStructuredBuffer<float4> _SkyDebugSamples;

float3 _DynamicGI_SkyVisibilityOrigin;
float3 _DynamicGI_SkyVisibilitySize;
int3 _DynamicGI_SkyVisibilityResolution;
int _DynamicGI_SkyVisibilityAvailable;

int3 _SkyUpdateOffset;
int3 _SkyUpdateSize;
int _SkyRayCount;
float _SkyMaxTraceDistance;
int _SkyMaxDdaSteps;
float _SkyRayOriginBias;
int _SkyQueryCount;

int3 _SkyDebugOffset;
int3 _SkyDebugSize;
int _SkyDebugSampleCount;
int _SkyDebugSampleStride;
float3 _SkyDebugCenter;
float _SkyDebugRadius;

float3 SkyVisibilityCellSize()
{
    return _DynamicGI_SkyVisibilitySize / (float3)_DynamicGI_SkyVisibilityResolution;
}

float3 SkyVisibilitySamplePosition(int3 coordinate)
{
    return _DynamicGI_SkyVisibilityOrigin + ((float3)coordinate + 0.5) * SkyVisibilityCellSize();
}

uint HashSkySample(int3 coordinate)
{
    uint hash = (uint)coordinate.x * 1597334677u;
    hash ^= (uint)coordinate.y * 3812015801u;
    hash ^= (uint)coordinate.z * 2798796415u;
    hash ^= hash >> 16;
    hash *= 2246822519u;
    hash ^= hash >> 13;
    return hash;
}

float3 HemisphereDirection(int rayIndex, int count, float azimuthRotation)
{
    const float goldenAngle = 2.39996323;
    float y = ((float)rayIndex + 0.5) / max(1.0, (float)count);
    float radial = sqrt(saturate(1.0 - y * y));
    float phi = (float)rayIndex * goldenAngle + azimuthRotation;
    return float3(cos(phi) * radial, y, sin(phi) * radial);
}

bool TraceGeometryDDA(float3 rayOriginWS, float3 rayDirectionWS, float maximumDistance)
{
    float3 relative = rayOriginWS - _DynamicGI_GeometryFieldOrigin;
    if (any(relative < 0.0) || any(relative >= _DynamicGI_GeometryFieldSize))
        return false;

    int3 fieldResolution = DynamicGIGetGeometryVoxelResolution();
    int3 voxel = (int3)floor(relative / _DynamicGI_GeometryVoxelSize);
    voxel = clamp(voxel, 0, fieldResolution - 1);
    if (DynamicGIReadGeometryVoxel(voxel) != 0u)
        return true;

    int3 stepDirection = int3(
        rayDirectionWS.x >= 0.0 ? 1 : -1,
        rayDirectionWS.y >= 0.0 ? 1 : -1,
        rayDirectionWS.z >= 0.0 ? 1 : -1);
    float3 safeDirection = float3(
        abs(rayDirectionWS.x) > 1e-6 ? rayDirectionWS.x : (rayDirectionWS.x >= 0.0 ? 1e-6 : -1e-6),
        abs(rayDirectionWS.y) > 1e-6 ? rayDirectionWS.y : (rayDirectionWS.y >= 0.0 ? 1e-6 : -1e-6),
        abs(rayDirectionWS.z) > 1e-6 ? rayDirectionWS.z : (rayDirectionWS.z >= 0.0 ? 1e-6 : -1e-6));

    float3 nextBoundaryWS = _DynamicGI_GeometryFieldOrigin + float3(
        stepDirection.x > 0 ? voxel.x + 1 : voxel.x,
        stepDirection.y > 0 ? voxel.y + 1 : voxel.y,
        stepDirection.z > 0 ? voxel.z + 1 : voxel.z) * _DynamicGI_GeometryVoxelSize;
    float3 nextCrossing = (nextBoundaryWS - rayOriginWS) / safeDirection;
    float3 crossingDelta = _DynamicGI_GeometryVoxelSize / abs(safeDirection);

    [loop]
    for (int stepIndex = 0; stepIndex < _SkyMaxDdaSteps; stepIndex++)
    {
        float nextDistance = min(nextCrossing.x, min(nextCrossing.y, nextCrossing.z));
        if (nextDistance > maximumDistance)
            return false;

        bool3 crossingMask = nextCrossing <= nextDistance + 1e-5;
        voxel += stepDirection * int3(crossingMask);
        nextCrossing += crossingDelta * float3(crossingMask);

        if (any(voxel < 0) || any(voxel >= fieldResolution))
            return false;
        if (DynamicGIReadGeometryVoxel(voxel) != 0u)
            return true;
    }

    return false;
}

float SampleSkyVisibilityTrilinear(float3 positionWS)
{
    float3 relative = positionWS - _DynamicGI_SkyVisibilityOrigin;
    if (_DynamicGI_SkyVisibilityAvailable == 0 || any(relative < 0.0) || any(relative >= _DynamicGI_SkyVisibilitySize))
        return 1.0;

    float3 uvw = saturate(relative / _DynamicGI_SkyVisibilitySize);
    return saturate(_SkyVisibilityRead.SampleLevel(sampler_SkyVisibilityRead, uvw, 0.0));
}

[numthreads(4, 4, 4)]
void ClearSkyVisibility(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (any(dispatchThreadId >= (uint3)_DynamicGI_SkyVisibilityResolution))
        return;

    _DynamicGI_SkyVisibilityTexture[dispatchThreadId] = 1.0;
}

[numthreads(4, 4, 4)]
void ComputeSkyVisibility(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (any(dispatchThreadId >= (uint3)_SkyUpdateSize))
        return;

    int3 sampleCoordinate = _SkyUpdateOffset + (int3)dispatchThreadId;
    if (any(sampleCoordinate < 0) || any(sampleCoordinate >= _DynamicGI_SkyVisibilityResolution))
        return;

    float3 samplePositionWS = SkyVisibilitySamplePosition(sampleCoordinate);
    if (SampleGeometryOccupancy(samplePositionWS) != 0u)
    {
        _DynamicGI_SkyVisibilityTexture[sampleCoordinate] = 0.0;
        return;
    }

    uint hash = HashSkySample(sampleCoordinate);
    float rotation = ((float)(hash & 0xffffu) / 65536.0) * 6.28318530718;
    float visibleRayCount = 0.0;

    [loop]
    for (int rayIndex = 0; rayIndex < _SkyRayCount; rayIndex++)
    {
        float3 direction = HemisphereDirection(rayIndex, _SkyRayCount, rotation);
        float3 origin = samplePositionWS + direction * _SkyRayOriginBias;
        visibleRayCount += TraceGeometryDDA(origin, direction, _SkyMaxTraceDistance) ? 0.0 : 1.0;
    }

    _DynamicGI_SkyVisibilityTexture[sampleCoordinate] = visibleRayCount / max(1.0, (float)_SkyRayCount);
}

[numthreads(64, 1, 1)]
void QuerySkyVisibility(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint queryIndex = dispatchThreadId.x;
    if (queryIndex >= (uint)_SkyQueryCount)
        return;

    _SkyQueryResults[queryIndex] = SampleSkyVisibilityTrilinear(_SkyQueryPositions[queryIndex]);
}

[numthreads(64, 1, 1)]
void BuildSkyVisibilityDebug(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint dispatchIndex = dispatchThreadId.x;
    if (dispatchIndex >= (uint)_SkyDebugSampleCount)
        return;

    uint linearIndex = dispatchIndex * (uint)_SkyDebugSampleStride;
    uint candidateCount = (uint)(_SkyDebugSize.x * _SkyDebugSize.y * _SkyDebugSize.z);
    if (linearIndex >= candidateCount)
        return;

    int3 localCoordinate;
    localCoordinate.x = (int)(linearIndex % (uint)_SkyDebugSize.x);
    localCoordinate.y = (int)((linearIndex / (uint)_SkyDebugSize.x) % (uint)_SkyDebugSize.y);
    localCoordinate.z = (int)(linearIndex / (uint)(_SkyDebugSize.x * _SkyDebugSize.y));
    int3 sampleCoordinate = _SkyDebugOffset + localCoordinate;
    float3 positionWS = SkyVisibilitySamplePosition(sampleCoordinate);
    if (_SkyDebugRadius > 0.0 && distance(positionWS, _SkyDebugCenter) > _SkyDebugRadius)
        return;

    float visibility = _SkyVisibilityRead.Load(int4(sampleCoordinate, 0));
    _SkyDebugSamples.Append(float4(positionWS, saturate(visibility)));
}
