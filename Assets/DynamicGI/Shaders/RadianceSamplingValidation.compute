#pragma kernel QueryDynamicGI
#pragma target 5.0

#include "RadianceField.hlsl"

StructuredBuffer<float3> _DynamicGISamplePositions;
StructuredBuffer<float3> _DynamicGISampleNormals;
RWStructuredBuffer<float4> _DynamicGISampleResults;
int _DynamicGISampleCount;

[numthreads(64, 1, 1)]
void QueryDynamicGI(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_DynamicGISampleCount)
        return;
    float3 value = SampleDynamicGI(_DynamicGISamplePositions[index], _DynamicGISampleNormals[index]);
    _DynamicGISampleResults[index] = float4(value, 1.0);
}
