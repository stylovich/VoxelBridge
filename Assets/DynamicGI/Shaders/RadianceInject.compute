#pragma kernel ClearRadiance
#pragma kernel InjectRadiance
#pragma kernel QueryRadiance
#pragma kernel BuildRadianceDebug
#pragma kernel QueryRadianceClipmapDebug
#pragma kernel BuildRadianceClipmapDebug
#pragma target 5.0

#include "GeometryField.hlsl"
#include "SkyVisibilityField.hlsl"

RWTexture3D<float4> _DynamicGI_RadiancePositiveX;
RWTexture3D<float4> _DynamicGI_RadianceNegativeX;
RWTexture3D<float4> _DynamicGI_RadiancePositiveY;
RWTexture3D<float4> _DynamicGI_RadianceNegativeY;
RWTexture3D<float4> _DynamicGI_RadiancePositiveZ;
RWTexture3D<float4> _DynamicGI_RadianceNegativeZ;

Texture3D<float4> _RadianceReadPositiveX;
Texture3D<float4> _RadianceReadNegativeX;
Texture3D<float4> _RadianceReadPositiveY;
Texture3D<float4> _RadianceReadNegativeY;
Texture3D<float4> _RadianceReadPositiveZ;
Texture3D<float4> _RadianceReadNegativeZ;
SamplerState sampler_RadianceReadPositiveX;

Texture3D<float4> _RadianceDebugDirectPositiveX;
Texture3D<float4> _RadianceDebugDirectNegativeX;
Texture3D<float4> _RadianceDebugDirectPositiveY;
Texture3D<float4> _RadianceDebugDirectNegativeY;
Texture3D<float4> _RadianceDebugDirectPositiveZ;
Texture3D<float4> _RadianceDebugDirectNegativeZ;

float3 _DynamicGI_RadianceOrigin;
float3 _DynamicGI_RadianceSize;
int3 _DynamicGI_RadianceResolution;
int _DynamicGI_RadianceAvailable;
int3 _RadianceRingOffset;
int _RadianceToroidal;

int3 _RadianceUpdateOffset;
int3 _RadianceUpdateSize;
float3 _RadianceSkyColor;
float _RadianceSkyIntensity;
float3 _RadianceSunDirection;
float3 _RadianceSunColor;
int _RadianceSunEnabled;
float _RadianceSunTraceDistance;
float _RadianceRayOriginBias;
int _RadianceMaxDdaSteps;

struct EmissiveContributorData
{
    float4 CenterAndRange;
    float4 Radiance;
    float4 BoundsExtentsAndMaxCascade;
};

StructuredBuffer<EmissiveContributorData> _GIEmissiveContributors;
int _GIEmissiveContributorCount;
int _RadianceCascadeIndex;

struct RadianceProbeData
{
    float4 PositiveX;
    float4 NegativeX;
    float4 PositiveY;
    float4 NegativeY;
    float4 PositiveZ;
    float4 NegativeZ;
};

struct RadianceDebugSample
{
    float4 PositionAndLuminance;
    float4 ColorAndValidity;
};

StructuredBuffer<float3> _RadianceQueryPositions;
RWStructuredBuffer<RadianceProbeData> _RadianceQueryResults;
RWStructuredBuffer<RadianceDebugSample> _RadianceDebugSamples;
int _RadianceQueryCount;

int3 _RadianceDebugOffset;
int3 _RadianceDebugSize;
int _RadianceDebugSampleCount;
int _RadianceDebugSampleStride;
int _RadianceDebugDirection;
int _RadianceDebugSource;
float3 _RadianceDebugCenter;
float _RadianceDebugRadius;

float3 RadianceCellSize()
{
    return _DynamicGI_RadianceSize / (float3)_DynamicGI_RadianceResolution;
}

float3 RadianceProbePosition(int3 coordinate)
{
    return _DynamicGI_RadianceOrigin + ((float3)coordinate + 0.5) * RadianceCellSize();
}

int3 RadiancePhysicalCoordinate(int3 logicalCoordinate)
{
    // Toroidal cascade resolutions are normalized to powers of two on the CPU.
    // The non-toroidal Phase-4 field bypasses this mask.
    return _RadianceToroidal != 0
        ? (logicalCoordinate + _RadianceRingOffset) & (_DynamicGI_RadianceResolution - 1)
        : logicalCoordinate;
}

float4 InjectAxis(float3 axis, float skyVisibility, float sunVisibility)
{
    // Uniform upper-hemisphere irradiance is strongest for +Y, half strength on
    // vertical surfaces, and zero for -Y. Direct sun uses the same normal basis.
    float skyWeight = saturate(axis.y * 0.5 + 0.5);
    float sunWeight = saturate(dot(axis, _RadianceSunDirection));
    float3 sky = _RadianceSkyColor * (_RadianceSkyIntensity * skyVisibility * skyWeight);
    float3 sun = _RadianceSunColor * (sunVisibility * sunWeight);
    return float4(max(0.0, sky + sun), 1.0);
}

void InjectEmissiveContributors(float3 positionWS, inout RadianceProbeData result)
{
    for (int contributorIndex = 0; contributorIndex < _GIEmissiveContributorCount; contributorIndex++)
    {
        EmissiveContributorData contributor = _GIEmissiveContributors[contributorIndex];
        if (_RadianceCascadeIndex > (int)contributor.BoundsExtentsAndMaxCascade.w)
            continue;

        float3 toSource = contributor.CenterAndRange.xyz - positionWS;
        float centerDistance = length(toSource);
        if (centerDistance <= 1e-5)
            continue;
        float3 direction = toSource / centerDistance;
        float sourceRadius = length(contributor.BoundsExtentsAndMaxCascade.xyz);
        float surfaceDistance = max(0.0, centerDistance - sourceRadius);
        float range = max(0.001, contributor.CenterAndRange.w);
        if (surfaceDistance >= range)
            continue;

        bool blocked = false;
        if (surfaceDistance > _RadianceRayOriginBias * 2.0)
        {
            float3 origin = positionWS + direction * _RadianceRayOriginBias;
            float traceDistance = max(0.0, surfaceDistance - _RadianceRayOriginBias * 2.0);
            blocked = DynamicGITraceGeometryDDA(origin, direction, traceDistance, _RadianceMaxDdaSteps);
        }
        if (blocked)
            continue;

        float falloff = saturate(1.0 - surfaceDistance / range);
        falloff *= falloff;
        float3 radiance = contributor.Radiance.rgb * falloff;
        result.PositiveX.rgb += radiance * saturate(direction.x);
        result.NegativeX.rgb += radiance * saturate(-direction.x);
        result.PositiveY.rgb += radiance * saturate(direction.y);
        result.NegativeY.rgb += radiance * saturate(-direction.y);
        result.PositiveZ.rgb += radiance * saturate(direction.z);
        result.NegativeZ.rgb += radiance * saturate(-direction.z);
    }
}

RadianceProbeData ReadRadianceLoad(int3 coordinate)
{
    coordinate = RadiancePhysicalCoordinate(coordinate);
    RadianceProbeData result;
    result.PositiveX = _RadianceReadPositiveX.Load(int4(coordinate, 0));
    result.NegativeX = _RadianceReadNegativeX.Load(int4(coordinate, 0));
    result.PositiveY = _RadianceReadPositiveY.Load(int4(coordinate, 0));
    result.NegativeY = _RadianceReadNegativeY.Load(int4(coordinate, 0));
    result.PositiveZ = _RadianceReadPositiveZ.Load(int4(coordinate, 0));
    result.NegativeZ = _RadianceReadNegativeZ.Load(int4(coordinate, 0));
    return result;
}

RadianceProbeData ReadDebugDirectLoad(int3 coordinate)
{
    coordinate = RadiancePhysicalCoordinate(coordinate);
    RadianceProbeData result;
    result.PositiveX = _RadianceDebugDirectPositiveX.Load(int4(coordinate, 0));
    result.NegativeX = _RadianceDebugDirectNegativeX.Load(int4(coordinate, 0));
    result.PositiveY = _RadianceDebugDirectPositiveY.Load(int4(coordinate, 0));
    result.NegativeY = _RadianceDebugDirectNegativeY.Load(int4(coordinate, 0));
    result.PositiveZ = _RadianceDebugDirectPositiveZ.Load(int4(coordinate, 0));
    result.NegativeZ = _RadianceDebugDirectNegativeZ.Load(int4(coordinate, 0));
    return result;
}

RadianceProbeData LerpRadiance(RadianceProbeData from, RadianceProbeData to, float weight)
{
    RadianceProbeData result;
    result.PositiveX = lerp(from.PositiveX, to.PositiveX, weight);
    result.NegativeX = lerp(from.NegativeX, to.NegativeX, weight);
    result.PositiveY = lerp(from.PositiveY, to.PositiveY, weight);
    result.NegativeY = lerp(from.NegativeY, to.NegativeY, weight);
    result.PositiveZ = lerp(from.PositiveZ, to.PositiveZ, weight);
    result.NegativeZ = lerp(from.NegativeZ, to.NegativeZ, weight);
    return result;
}

RadianceProbeData SampleToroidalRadiance(float3 relative)
{
    float3 gridPosition = relative / RadianceCellSize() - 0.5;
    int3 baseCoordinate = (int3)floor(gridPosition);
    float3 weight = frac(gridPosition);
    int3 c0 = clamp(baseCoordinate, 0, _DynamicGI_RadianceResolution - 1);
    int3 c1 = clamp(baseCoordinate + 1, 0, _DynamicGI_RadianceResolution - 1);

    RadianceProbeData v000 = ReadRadianceLoad(int3(c0.x, c0.y, c0.z));
    RadianceProbeData v100 = ReadRadianceLoad(int3(c1.x, c0.y, c0.z));
    RadianceProbeData v010 = ReadRadianceLoad(int3(c0.x, c1.y, c0.z));
    RadianceProbeData v110 = ReadRadianceLoad(int3(c1.x, c1.y, c0.z));
    RadianceProbeData v001 = ReadRadianceLoad(int3(c0.x, c0.y, c1.z));
    RadianceProbeData v101 = ReadRadianceLoad(int3(c1.x, c0.y, c1.z));
    RadianceProbeData v011 = ReadRadianceLoad(int3(c0.x, c1.y, c1.z));
    RadianceProbeData v111 = ReadRadianceLoad(int3(c1.x, c1.y, c1.z));
    RadianceProbeData z0 = LerpRadiance(
        LerpRadiance(v000, v100, weight.x),
        LerpRadiance(v010, v110, weight.x),
        weight.y);
    RadianceProbeData z1 = LerpRadiance(
        LerpRadiance(v001, v101, weight.x),
        LerpRadiance(v011, v111, weight.x),
        weight.y);
    return LerpRadiance(z0, z1, weight.z);
}

RadianceProbeData SampleToroidalDebugDirect(float3 relative)
{
    float3 gridPosition = relative / RadianceCellSize() - 0.5;
    int3 baseCoordinate = (int3)floor(gridPosition);
    float3 weight = frac(gridPosition);
    int3 c0 = clamp(baseCoordinate, 0, _DynamicGI_RadianceResolution - 1);
    int3 c1 = clamp(baseCoordinate + 1, 0, _DynamicGI_RadianceResolution - 1);

    RadianceProbeData v000 = ReadDebugDirectLoad(int3(c0.x, c0.y, c0.z));
    RadianceProbeData v100 = ReadDebugDirectLoad(int3(c1.x, c0.y, c0.z));
    RadianceProbeData v010 = ReadDebugDirectLoad(int3(c0.x, c1.y, c0.z));
    RadianceProbeData v110 = ReadDebugDirectLoad(int3(c1.x, c1.y, c0.z));
    RadianceProbeData v001 = ReadDebugDirectLoad(int3(c0.x, c0.y, c1.z));
    RadianceProbeData v101 = ReadDebugDirectLoad(int3(c1.x, c0.y, c1.z));
    RadianceProbeData v011 = ReadDebugDirectLoad(int3(c0.x, c1.y, c1.z));
    RadianceProbeData v111 = ReadDebugDirectLoad(int3(c1.x, c1.y, c1.z));
    RadianceProbeData z0 = LerpRadiance(
        LerpRadiance(v000, v100, weight.x),
        LerpRadiance(v010, v110, weight.x),
        weight.y);
    RadianceProbeData z1 = LerpRadiance(
        LerpRadiance(v001, v101, weight.x),
        LerpRadiance(v011, v111, weight.x),
        weight.y);
    return LerpRadiance(z0, z1, weight.z);
}

float4 SelectDebugLobe(float4 resolved, float4 directValue)
{
    if (_RadianceDebugSource == 1)
        return directValue;
    if (_RadianceDebugSource == 2)
        return float4(max(0.0, resolved.rgb - directValue.rgb), resolved.a);
    return resolved;
}

RadianceProbeData SelectDebugSource(RadianceProbeData resolved, RadianceProbeData directValue)
{
    RadianceProbeData result;
    result.PositiveX = SelectDebugLobe(resolved.PositiveX, directValue.PositiveX);
    result.NegativeX = SelectDebugLobe(resolved.NegativeX, directValue.NegativeX);
    result.PositiveY = SelectDebugLobe(resolved.PositiveY, directValue.PositiveY);
    result.NegativeY = SelectDebugLobe(resolved.NegativeY, directValue.NegativeY);
    result.PositiveZ = SelectDebugLobe(resolved.PositiveZ, directValue.PositiveZ);
    result.NegativeZ = SelectDebugLobe(resolved.NegativeZ, directValue.NegativeZ);
    return result;
}

float3 SelectDebugRadiance(RadianceProbeData value, int direction)
{
    if (direction == 1) return value.PositiveX.rgb;
    if (direction == 2) return value.NegativeX.rgb;
    if (direction == 3) return value.PositiveY.rgb;
    if (direction == 4) return value.NegativeY.rgb;
    if (direction == 5) return value.PositiveZ.rgb;
    if (direction == 6) return value.NegativeZ.rgb;
    if (direction == 7)
    {
        float3 maximum = max(value.PositiveX.rgb, value.NegativeX.rgb);
        maximum = max(maximum, value.PositiveY.rgb);
        maximum = max(maximum, value.NegativeY.rgb);
        maximum = max(maximum, value.PositiveZ.rgb);
        return max(maximum, value.NegativeZ.rgb);
    }

    return (value.PositiveX.rgb + value.NegativeX.rgb + value.PositiveY.rgb +
            value.NegativeY.rgb + value.PositiveZ.rgb + value.NegativeZ.rgb) / 6.0;
}

[numthreads(4, 4, 4)]
void ClearRadiance(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (any(dispatchThreadId >= (uint3)_DynamicGI_RadianceResolution))
        return;
    float4 zero = 0.0;
    _DynamicGI_RadiancePositiveX[dispatchThreadId] = zero;
    _DynamicGI_RadianceNegativeX[dispatchThreadId] = zero;
    _DynamicGI_RadiancePositiveY[dispatchThreadId] = zero;
    _DynamicGI_RadianceNegativeY[dispatchThreadId] = zero;
    _DynamicGI_RadiancePositiveZ[dispatchThreadId] = zero;
    _DynamicGI_RadianceNegativeZ[dispatchThreadId] = zero;
}

[numthreads(4, 4, 4)]
void InjectRadiance(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (any(dispatchThreadId >= (uint3)_RadianceUpdateSize))
        return;

    int3 coordinate = _RadianceUpdateOffset + (int3)dispatchThreadId;
    if (any(coordinate < 0) || any(coordinate >= _DynamicGI_RadianceResolution))
        return;

    float3 positionWS = RadianceProbePosition(coordinate);
    int3 physicalCoordinate = RadiancePhysicalCoordinate(coordinate);
    if (SampleGeometryOccupancy(positionWS) != 0u)
    {
        float4 zero = 0.0;
        _DynamicGI_RadiancePositiveX[physicalCoordinate] = zero;
        _DynamicGI_RadianceNegativeX[physicalCoordinate] = zero;
        _DynamicGI_RadiancePositiveY[physicalCoordinate] = zero;
        _DynamicGI_RadianceNegativeY[physicalCoordinate] = zero;
        _DynamicGI_RadiancePositiveZ[physicalCoordinate] = zero;
        _DynamicGI_RadianceNegativeZ[physicalCoordinate] = zero;
        return;
    }

    float skyVisibility = SampleSkyVisibility(positionWS);
    float sunVisibility = 0.0;
    if (_RadianceSunEnabled != 0)
    {
        float3 origin = positionWS + _RadianceSunDirection * _RadianceRayOriginBias;
        bool blocked = DynamicGITraceGeometryDDA(
            origin,
            _RadianceSunDirection,
            _RadianceSunTraceDistance,
            _RadianceMaxDdaSteps);
        sunVisibility = blocked ? 0.0 : 1.0;
    }

    RadianceProbeData result;
    result.PositiveX = InjectAxis(float3(1.0, 0.0, 0.0), skyVisibility, sunVisibility);
    result.NegativeX = InjectAxis(float3(-1.0, 0.0, 0.0), skyVisibility, sunVisibility);
    result.PositiveY = InjectAxis(float3(0.0, 1.0, 0.0), skyVisibility, sunVisibility);
    result.NegativeY = InjectAxis(float3(0.0, -1.0, 0.0), skyVisibility, sunVisibility);
    result.PositiveZ = InjectAxis(float3(0.0, 0.0, 1.0), skyVisibility, sunVisibility);
    result.NegativeZ = InjectAxis(float3(0.0, 0.0, -1.0), skyVisibility, sunVisibility);
    InjectEmissiveContributors(positionWS, result);
    _DynamicGI_RadiancePositiveX[physicalCoordinate] = result.PositiveX;
    _DynamicGI_RadianceNegativeX[physicalCoordinate] = result.NegativeX;
    _DynamicGI_RadiancePositiveY[physicalCoordinate] = result.PositiveY;
    _DynamicGI_RadianceNegativeY[physicalCoordinate] = result.NegativeY;
    _DynamicGI_RadiancePositiveZ[physicalCoordinate] = result.PositiveZ;
    _DynamicGI_RadianceNegativeZ[physicalCoordinate] = result.NegativeZ;
}

[numthreads(64, 1, 1)]
void QueryRadiance(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_RadianceQueryCount)
        return;

    RadianceProbeData result;
    result.PositiveX = 0.0;
    result.NegativeX = 0.0;
    result.PositiveY = 0.0;
    result.NegativeY = 0.0;
    result.PositiveZ = 0.0;
    result.NegativeZ = 0.0;
    float3 relative = _RadianceQueryPositions[index] - _DynamicGI_RadianceOrigin;
    if (_DynamicGI_RadianceAvailable != 0 && all(relative >= 0.0) && all(relative < _DynamicGI_RadianceSize))
    {
        if (_RadianceToroidal != 0)
        {
            // Clamp in logical space before applying the ring. Hardware repeat filtering
            // would interpolate the two opposite world-space field boundaries together.
            result = SampleToroidalRadiance(relative);
        }
        else
        {
            float3 uvw = saturate(relative / _DynamicGI_RadianceSize);
            result.PositiveX = _RadianceReadPositiveX.SampleLevel(sampler_RadianceReadPositiveX, uvw, 0.0);
            result.NegativeX = _RadianceReadNegativeX.SampleLevel(sampler_RadianceReadPositiveX, uvw, 0.0);
            result.PositiveY = _RadianceReadPositiveY.SampleLevel(sampler_RadianceReadPositiveX, uvw, 0.0);
            result.NegativeY = _RadianceReadNegativeY.SampleLevel(sampler_RadianceReadPositiveX, uvw, 0.0);
            result.PositiveZ = _RadianceReadPositiveZ.SampleLevel(sampler_RadianceReadPositiveX, uvw, 0.0);
            result.NegativeZ = _RadianceReadNegativeZ.SampleLevel(sampler_RadianceReadPositiveX, uvw, 0.0);
        }
    }
    _RadianceQueryResults[index] = result;
}

[numthreads(64, 1, 1)]
void BuildRadianceDebug(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint dispatchIndex = dispatchThreadId.x;
    if (dispatchIndex >= (uint)_RadianceDebugSampleCount)
        return;

    uint linearIndex = dispatchIndex * (uint)_RadianceDebugSampleStride;
    uint candidateCount = (uint)(_RadianceDebugSize.x * _RadianceDebugSize.y * _RadianceDebugSize.z);
    if (linearIndex >= candidateCount)
        return;

    int3 localCoordinate;
    localCoordinate.x = (int)(linearIndex % (uint)_RadianceDebugSize.x);
    localCoordinate.y = (int)((linearIndex / (uint)_RadianceDebugSize.x) % (uint)_RadianceDebugSize.y);
    localCoordinate.z = (int)(linearIndex / (uint)(_RadianceDebugSize.x * _RadianceDebugSize.y));
    int3 coordinate = _RadianceDebugOffset + localCoordinate;
    float3 positionWS = RadianceProbePosition(coordinate);
    RadianceProbeData radiance = ReadRadianceLoad(coordinate);
    float3 color = SelectDebugRadiance(radiance, _RadianceDebugDirection);
    float luminance = dot(color, float3(0.2126, 0.7152, 0.0722));
    float validity = saturate((radiance.PositiveX.a + radiance.NegativeX.a + radiance.PositiveY.a +
                               radiance.NegativeY.a + radiance.PositiveZ.a + radiance.NegativeZ.a) / 6.0);
    if (_RadianceDebugRadius > 0.0 && distance(positionWS, _RadianceDebugCenter) > _RadianceDebugRadius)
        validity = 0.0;

    RadianceDebugSample sample;
    sample.PositionAndLuminance = float4(positionWS, luminance);
    sample.ColorAndValidity = float4(color, validity);
    _RadianceDebugSamples[dispatchIndex] = sample;
}

[numthreads(64, 1, 1)]
void QueryRadianceClipmapDebug(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint index = dispatchThreadId.x;
    if (index >= (uint)_RadianceQueryCount)
        return;

    RadianceProbeData result;
    result.PositiveX = 0.0;
    result.NegativeX = 0.0;
    result.PositiveY = 0.0;
    result.NegativeY = 0.0;
    result.PositiveZ = 0.0;
    result.NegativeZ = 0.0;
    float3 relative = _RadianceQueryPositions[index] - _DynamicGI_RadianceOrigin;
    if (_DynamicGI_RadianceAvailable != 0 && all(relative >= 0.0) && all(relative < _DynamicGI_RadianceSize))
    {
        RadianceProbeData resolved = SampleToroidalRadiance(relative);
        RadianceProbeData directValue = SampleToroidalDebugDirect(relative);
        result = SelectDebugSource(resolved, directValue);
    }
    _RadianceQueryResults[index] = result;
}

[numthreads(64, 1, 1)]
void BuildRadianceClipmapDebug(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint dispatchIndex = dispatchThreadId.x;
    if (dispatchIndex >= (uint)_RadianceDebugSampleCount)
        return;

    uint linearIndex = dispatchIndex * (uint)_RadianceDebugSampleStride;
    uint candidateCount = (uint)(_RadianceDebugSize.x * _RadianceDebugSize.y * _RadianceDebugSize.z);
    if (linearIndex >= candidateCount)
        return;

    int3 localCoordinate;
    localCoordinate.x = (int)(linearIndex % (uint)_RadianceDebugSize.x);
    localCoordinate.y = (int)((linearIndex / (uint)_RadianceDebugSize.x) % (uint)_RadianceDebugSize.y);
    localCoordinate.z = (int)(linearIndex / (uint)(_RadianceDebugSize.x * _RadianceDebugSize.y));
    int3 coordinate = _RadianceDebugOffset + localCoordinate;
    float3 positionWS = RadianceProbePosition(coordinate);
    RadianceProbeData resolved = ReadRadianceLoad(coordinate);
    RadianceProbeData directValue = ReadDebugDirectLoad(coordinate);
    RadianceProbeData radiance = SelectDebugSource(resolved, directValue);
    float3 color = SelectDebugRadiance(radiance, _RadianceDebugDirection);
    float luminance = dot(color, float3(0.2126, 0.7152, 0.0722));
    float validity = saturate((radiance.PositiveX.a + radiance.NegativeX.a + radiance.PositiveY.a +
                               radiance.NegativeY.a + radiance.PositiveZ.a + radiance.NegativeZ.a) / 6.0);
    if (_RadianceDebugRadius > 0.0 && distance(positionWS, _RadianceDebugCenter) > _RadianceDebugRadius)
        validity = 0.0;

    RadianceDebugSample sample;
    sample.PositionAndLuminance = float4(positionWS, luminance);
    sample.ColorAndValidity = float4(color, validity);
    _RadianceDebugSamples[dispatchIndex] = sample;
}
