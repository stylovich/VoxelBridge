#pragma kernel ClearBrick
#pragma kernel VoxelizeTriangles
#pragma kernel QueryOccupancy
#pragma kernel BuildDebugVoxels
#pragma target 5.0

RWStructuredBuffer<uint> _DynamicGI_BaseOccupancy;
RWStructuredBuffer<uint> _DynamicGI_DynamicOccupancy;
StructuredBuffer<int4> _DynamicGI_GeometryPageTable;
StructuredBuffer<int4> _DynamicGI_ActiveBricks;

ByteAddressBuffer _VertexBuffer;
ByteAddressBuffer _IndexBuffer;

StructuredBuffer<float3> _QueryPositions;
RWStructuredBuffer<uint> _QueryResults;
AppendStructuredBuffer<float4> _DebugVoxels;

float4x4 _LocalToWorld;
float3 _DynamicGI_GeometryFieldOrigin;
float3 _DynamicGI_GeometryFieldSize;
float _DynamicGI_GeometryVoxelSize;
float _DynamicGI_GeometryBrickWorldSize;
int _DynamicGI_GeometryBrickResolution;
int _DynamicGI_GeometryWordsPerBrick;
int _DynamicGI_GeometryPageTableCapacity;

int3 _TargetBrickCoordinate;
int _TargetBrickSlot;
int _TargetIsDynamic;
int _VertexStride;
int _PositionOffset;
int _IndexFormat;
int _StartIndex;
int _BaseVertex;
int _TriangleCount;
int _QueryCount;
int _ActiveBrickCount;
int _DebugSampleCount;
int _DebugSampleStride;
int _DebugMode;
float3 _DebugCenter;
float _DebugRadius;

uint HashBrickCoordinate(int3 coordinate)
{
    uint hash = (uint)coordinate.x * 73856093u;
    hash ^= (uint)coordinate.y * 19349663u;
    hash ^= (uint)coordinate.z * 83492791u;
    hash ^= hash >> 16;
    hash *= 0x7feb352du;
    hash ^= hash >> 15;
    hash *= 0x846ca68bu;
    hash ^= hash >> 16;
    return hash;
}

int FindBrickSlot(int3 coordinate)
{
    if (_DynamicGI_GeometryPageTableCapacity <= 0)
        return -1;

    uint mask = (uint)(_DynamicGI_GeometryPageTableCapacity - 1);
    uint tableIndex = HashBrickCoordinate(coordinate) & mask;

    [loop]
    for (int probe = 0; probe < _DynamicGI_GeometryPageTableCapacity; probe++)
    {
        int4 entry = _DynamicGI_GeometryPageTable[tableIndex];
        if (entry.w == 0)
            return -1;

        if (all(entry.xyz == coordinate))
            return entry.w - 1;

        tableIndex = (tableIndex + 1u) & mask;
    }

    return -1;
}

uint ReadOccupancyBit(int slot, int3 localVoxel)
{
    int resolution = _DynamicGI_GeometryBrickResolution;
    int linearIndex = localVoxel.x + resolution * (localVoxel.y + resolution * localVoxel.z);
    int wordIndex = slot * _DynamicGI_GeometryWordsPerBrick + (linearIndex >> 5);
    uint mask = 1u << (linearIndex & 31);
    return ((_DynamicGI_BaseOccupancy[wordIndex] | _DynamicGI_DynamicOccupancy[wordIndex]) & mask) != 0u;
}

uint SampleOccupancy(float3 positionWS)
{
    float3 relative = positionWS - _DynamicGI_GeometryFieldOrigin;
    if (any(relative < 0.0) || any(relative >= _DynamicGI_GeometryFieldSize))
        return 0u;

    uint3 globalVoxel = (uint3)floor(relative / _DynamicGI_GeometryVoxelSize);
    uint resolution = (uint)_DynamicGI_GeometryBrickResolution;
    int3 brickCoordinate = (int3)(globalVoxel / resolution);
    int3 localVoxel = (int3)(globalVoxel - (uint3)brickCoordinate * resolution);
    int slot = FindBrickSlot(brickCoordinate);
    return slot >= 0 ? ReadOccupancyBit(slot, localVoxel) : 0u;
}

uint LoadIndex(int index)
{
    if (_IndexFormat == 32)
        return _IndexBuffer.Load(index * 4);

    uint byteAddress = (uint)index * 2u;
    uint packed = _IndexBuffer.Load(byteAddress & ~3u);
    uint shift = (byteAddress & 2u) * 8u;
    return (packed >> shift) & 0xffffu;
}

float3 LoadPosition(uint vertexIndex)
{
    uint address = vertexIndex * (uint)_VertexStride + (uint)_PositionOffset;
    return asfloat(_VertexBuffer.Load3(address));
}

bool SeparatingAxis(float3 axis, float3 v0, float3 v1, float3 v2, float3 halfSize)
{
    float axisLengthSq = dot(axis, axis);
    if (axisLengthSq < 1e-12)
        return false;

    float p0 = dot(v0, axis);
    float p1 = dot(v1, axis);
    float p2 = dot(v2, axis);
    float minimum = min(p0, min(p1, p2));
    float maximum = max(p0, max(p1, p2));
    float radius = dot(abs(axis), halfSize);
    return minimum > radius || maximum < -radius;
}

bool TriangleBoxOverlap(float3 boxCenter, float3 halfSize, float3 worldV0, float3 worldV1, float3 worldV2)
{
    float3 v0 = worldV0 - boxCenter;
    float3 v1 = worldV1 - boxCenter;
    float3 v2 = worldV2 - boxCenter;
    float3 e0 = v1 - v0;
    float3 e1 = v2 - v1;
    float3 e2 = v0 - v2;

    if (max(v0.x, max(v1.x, v2.x)) < -halfSize.x || min(v0.x, min(v1.x, v2.x)) > halfSize.x)
        return false;
    if (max(v0.y, max(v1.y, v2.y)) < -halfSize.y || min(v0.y, min(v1.y, v2.y)) > halfSize.y)
        return false;
    if (max(v0.z, max(v1.z, v2.z)) < -halfSize.z || min(v0.z, min(v1.z, v2.z)) > halfSize.z)
        return false;

    if (SeparatingAxis(cross(e0, e1), v0, v1, v2, halfSize))
        return false;

    const float3 axisX = float3(1.0, 0.0, 0.0);
    const float3 axisY = float3(0.0, 1.0, 0.0);
    const float3 axisZ = float3(0.0, 0.0, 1.0);

    if (SeparatingAxis(cross(e0, axisX), v0, v1, v2, halfSize) ||
        SeparatingAxis(cross(e0, axisY), v0, v1, v2, halfSize) ||
        SeparatingAxis(cross(e0, axisZ), v0, v1, v2, halfSize) ||
        SeparatingAxis(cross(e1, axisX), v0, v1, v2, halfSize) ||
        SeparatingAxis(cross(e1, axisY), v0, v1, v2, halfSize) ||
        SeparatingAxis(cross(e1, axisZ), v0, v1, v2, halfSize) ||
        SeparatingAxis(cross(e2, axisX), v0, v1, v2, halfSize) ||
        SeparatingAxis(cross(e2, axisY), v0, v1, v2, halfSize) ||
        SeparatingAxis(cross(e2, axisZ), v0, v1, v2, halfSize))
        return false;

    return true;
}

[numthreads(64, 1, 1)]
void ClearBrick(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint word = dispatchThreadId.x;
    if (word >= (uint)_DynamicGI_GeometryWordsPerBrick)
        return;

    uint address = (uint)(_TargetBrickSlot * _DynamicGI_GeometryWordsPerBrick) + word;
    _DynamicGI_BaseOccupancy[address] = 0u;
    _DynamicGI_DynamicOccupancy[address] = 0u;
}

[numthreads(64, 1, 1)]
void VoxelizeTriangles(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint triangleIndex = dispatchThreadId.x;
    if (triangleIndex >= (uint)_TriangleCount)
        return;

    int firstIndex = _StartIndex + (int)triangleIndex * 3;
    uint i0 = LoadIndex(firstIndex) + (uint)_BaseVertex;
    uint i1 = LoadIndex(firstIndex + 1) + (uint)_BaseVertex;
    uint i2 = LoadIndex(firstIndex + 2) + (uint)_BaseVertex;

    float3 v0 = mul(_LocalToWorld, float4(LoadPosition(i0), 1.0)).xyz;
    float3 v1 = mul(_LocalToWorld, float4(LoadPosition(i1), 1.0)).xyz;
    float3 v2 = mul(_LocalToWorld, float4(LoadPosition(i2), 1.0)).xyz;

    float3 triangleMinimum = min(v0, min(v1, v2));
    float3 triangleMaximum = max(v0, max(v1, v2));
    float3 brickMinimum = _DynamicGI_GeometryFieldOrigin + (float3)_TargetBrickCoordinate * _DynamicGI_GeometryBrickWorldSize;
    float3 brickMaximum = brickMinimum + _DynamicGI_GeometryBrickWorldSize;

    if (any(triangleMaximum < brickMinimum) || any(triangleMinimum >= brickMaximum))
        return;

    int resolution = _DynamicGI_GeometryBrickResolution;
    int3 localMinimum = clamp((int3)floor((triangleMinimum - brickMinimum) / _DynamicGI_GeometryVoxelSize), 0, resolution - 1);
    int3 localMaximum = clamp((int3)floor((triangleMaximum - brickMinimum) / _DynamicGI_GeometryVoxelSize), 0, resolution - 1);
    float3 voxelHalfSize = _DynamicGI_GeometryVoxelSize * 0.5;

    [loop]
    for (int z = localMinimum.z; z <= localMaximum.z; z++)
    {
        [loop]
        for (int y = localMinimum.y; y <= localMaximum.y; y++)
        {
            [loop]
            for (int x = localMinimum.x; x <= localMaximum.x; x++)
            {
                int3 localVoxel = int3(x, y, z);
                float3 voxelCenter = brickMinimum + ((float3)localVoxel + 0.5) * _DynamicGI_GeometryVoxelSize;
                if (!TriangleBoxOverlap(voxelCenter, voxelHalfSize, v0, v1, v2))
                    continue;

                int linearIndex = x + resolution * (y + resolution * z);
                int wordIndex = _TargetBrickSlot * _DynamicGI_GeometryWordsPerBrick + (linearIndex >> 5);
                uint bitMask = 1u << (linearIndex & 31);
                uint previous;

                if (_TargetIsDynamic != 0)
                    InterlockedOr(_DynamicGI_DynamicOccupancy[wordIndex], bitMask, previous);
                else
                    InterlockedOr(_DynamicGI_BaseOccupancy[wordIndex], bitMask, previous);
            }
        }
    }
}

[numthreads(64, 1, 1)]
void QueryOccupancy(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint queryIndex = dispatchThreadId.x;
    if (queryIndex >= (uint)_QueryCount)
        return;

    _QueryResults[queryIndex] = SampleOccupancy(_QueryPositions[queryIndex]);
}

[numthreads(64, 1, 1)]
void BuildDebugVoxels(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint sampleIndex = dispatchThreadId.x;
    if (sampleIndex >= (uint)_DebugSampleCount)
        return;

    uint voxelIndex = sampleIndex * (uint)_DebugSampleStride;
    uint voxelsPerBrick = (uint)(_DynamicGI_GeometryBrickResolution * _DynamicGI_GeometryBrickResolution * _DynamicGI_GeometryBrickResolution);
    uint activeBrickIndex = voxelIndex / voxelsPerBrick;
    if (activeBrickIndex >= (uint)_ActiveBrickCount)
        return;

    uint localLinear = voxelIndex - activeBrickIndex * voxelsPerBrick;
    int4 activeBrick = _DynamicGI_ActiveBricks[activeBrickIndex];
    int slot = activeBrick.w - 1;
    int resolution = _DynamicGI_GeometryBrickResolution;
    int3 localVoxel;
    localVoxel.x = (int)(localLinear % (uint)resolution);
    localVoxel.y = (int)((localLinear / (uint)resolution) % (uint)resolution);
    localVoxel.z = (int)(localLinear / (uint)(resolution * resolution));

    int3 brickCoordinate = activeBrick.xyz;

    uint occupied = ReadOccupancyBit(slot, localVoxel);
    if ((_DebugMode == 0 && occupied == 0u) || (_DebugMode == 1 && occupied != 0u))
        return;

    float3 brickMinimum = _DynamicGI_GeometryFieldOrigin + (float3)brickCoordinate * _DynamicGI_GeometryBrickWorldSize;
    float3 positionWS = brickMinimum + ((float3)localVoxel + 0.5) * _DynamicGI_GeometryVoxelSize;
    if (_DebugRadius > 0.0 && distance(positionWS, _DebugCenter) > _DebugRadius)
        return;

    _DebugVoxels.Append(float4(positionWS, occupied != 0u ? 1.0 : 0.0));
}
