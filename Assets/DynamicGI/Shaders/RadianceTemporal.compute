#pragma kernel AccumulateRadianceTemporal
#pragma target 5.0

RWTexture3D<float4> _DynamicGI_RadiancePositiveX;
RWTexture3D<float4> _DynamicGI_RadianceNegativeX;
RWTexture3D<float4> _DynamicGI_RadiancePositiveY;
RWTexture3D<float4> _DynamicGI_RadianceNegativeY;
RWTexture3D<float4> _DynamicGI_RadiancePositiveZ;
RWTexture3D<float4> _DynamicGI_RadianceNegativeZ;

Texture3D<float4> _TemporalCandidatePositiveX;
Texture3D<float4> _TemporalCandidateNegativeX;
Texture3D<float4> _TemporalCandidatePositiveY;
Texture3D<float4> _TemporalCandidateNegativeY;
Texture3D<float4> _TemporalCandidatePositiveZ;
Texture3D<float4> _TemporalCandidateNegativeZ;

int3 _DynamicGI_RadianceResolution;
int3 _RadianceRingOffset;
int _RadianceToroidal;
int3 _TemporalUpdateOffset;
int3 _TemporalUpdateSize;
float _TemporalAlpha;
int _TemporalForceReplace;

int3 RadiancePhysicalCoordinate(int3 logicalCoordinate)
{
    return _RadianceToroidal != 0
        ? (logicalCoordinate + _RadianceRingOffset) & (_DynamicGI_RadianceResolution - 1)
        : logicalCoordinate;
}

float4 ResolveTemporal(float4 previous, float4 candidate)
{
    // Invalid candidates usually represent newly occupied probes. Clearing them
    // immediately is safer than allowing stale light to leak through new geometry.
    if (candidate.a <= 0.0)
        return candidate;

    float alpha = (_TemporalForceReplace != 0 || previous.a <= 0.0)
        ? 1.0
        : saturate(_TemporalAlpha);
    return float4(lerp(previous.rgb, candidate.rgb, alpha), candidate.a);
}

[numthreads(4, 4, 4)]
void AccumulateRadianceTemporal(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    if (any(dispatchThreadId >= (uint3)_TemporalUpdateSize))
        return;

    int3 logicalCoordinate = _TemporalUpdateOffset + (int3)dispatchThreadId;
    if (any(logicalCoordinate < 0) || any(logicalCoordinate >= _DynamicGI_RadianceResolution))
        return;

    int3 coordinate = RadiancePhysicalCoordinate(logicalCoordinate);
    _DynamicGI_RadiancePositiveX[coordinate] = ResolveTemporal(
        _DynamicGI_RadiancePositiveX[coordinate],
        _TemporalCandidatePositiveX.Load(int4(coordinate, 0)));
    _DynamicGI_RadianceNegativeX[coordinate] = ResolveTemporal(
        _DynamicGI_RadianceNegativeX[coordinate],
        _TemporalCandidateNegativeX.Load(int4(coordinate, 0)));
    _DynamicGI_RadiancePositiveY[coordinate] = ResolveTemporal(
        _DynamicGI_RadiancePositiveY[coordinate],
        _TemporalCandidatePositiveY.Load(int4(coordinate, 0)));
    _DynamicGI_RadianceNegativeY[coordinate] = ResolveTemporal(
        _DynamicGI_RadianceNegativeY[coordinate],
        _TemporalCandidateNegativeY.Load(int4(coordinate, 0)));
    _DynamicGI_RadiancePositiveZ[coordinate] = ResolveTemporal(
        _DynamicGI_RadiancePositiveZ[coordinate],
        _TemporalCandidatePositiveZ.Load(int4(coordinate, 0)));
    _DynamicGI_RadianceNegativeZ[coordinate] = ResolveTemporal(
        _DynamicGI_RadianceNegativeZ[coordinate],
        _TemporalCandidateNegativeZ.Load(int4(coordinate, 0)));
}
